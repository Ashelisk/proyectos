{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "task_id", "active_branch", "last_known_commit", "last_platform", "status", "cycle", "tests", "next_action", "blocked_reason", "updated_at"],
  "properties": {
    "$schema": {"const": "state.schema.json"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "active_branch": {"type": "string", "minLength": 1},
    "last_known_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "last_platform": {"enum": ["windows", "linux", "macos", "ci"]},
    "status": {"enum": ["IN_PROGRESS", "PASS", "FAIL", "BLOCKED", "NEEDS_HUMAN"]},
    "cycle": {"type": "integer", "minimum": 0},
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows", "linux", "macos", "ci"],
      "properties": {
        "windows": {"$ref": "#/$defs/testResult"},
        "linux": {"$ref": "#/$defs/testResult"},
        "macos": {"$ref": "#/$defs/testResult"},
        "ci": {"$ref": "#/$defs/testResult"}
      }
    },
    "next_action": {"type": "string", "minLength": 1},
    "blocked_reason": {"type": ["string", "null"]},
    "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "$defs": {
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command", "summary"],
      "properties": {
        "status": {"enum": ["PENDING", "PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
        "command": {"type": ["string", "null"]},
        "summary": {"type": "string"}
      }
    }
  }
}
